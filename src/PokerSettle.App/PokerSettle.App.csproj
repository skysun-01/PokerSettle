<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>PokerSettle.App</RootNamespace>
		<!-- Windows: the executable is PokerSettle.exe -->
		<AssemblyName>PokerSettle</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- XAML is compiled to C# at build time; with x:DataType everywhere all bindings are compiled. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!-- Fail the build on any binding that can't be compiled (missing x:DataType). -->
		<WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025</WarningsAsErrors>

		<ApplicationTitle>Poker Settle</ApplicationTitle>
		<ApplicationId>com.pokersettle.app</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Unpackaged: a plain .exe. Never change this; packaged apps keep data in a different folder. -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- All JSON goes through source-generated contexts (trimming-safe). -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<!-- Sideloaded release builds are APKs, not app bundles. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<!-- 64-bit phones, plus 32-bit ARM for budget phones running 32-bit Android (e.g. Android Go). -->
		<RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E6B47" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E6B47" BaseSize="160,160" />
		<MauiImage Include="Resources\Images\*.svg" />
		<!-- Tab icons: a mid-tone that reads on light and dark backgrounds (Android tints them anyway). -->
		<MauiImage Update="Resources\Images\tab_*.svg" TintColor="#6B7C72" BaseSize="24,24" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PokerSettle.Core\PokerSettle.Core.csproj" />
	</ItemGroup>

</Project>
