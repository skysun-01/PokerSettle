<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:PokerSettle.App.Pages"
                xmlns:controls="clr-namespace:PokerSettle.App.Controls"
                xmlns:vm="clr-namespace:PokerSettle.Core.ViewModels.Players;assembly=PokerSettle.Core"
                x:Class="PokerSettle.App.Pages.PlayersPage"
                SnackbarInset="84"
                x:DataType="vm:PlayersViewModel"
                Title="Players">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New game" Command="{Binding NewGameCommand}" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <SearchBar Text="{Binding SearchText}" Placeholder="Search players" Margin="8,4,8,0"
                   SemanticProperties.Description="Search players" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Padding="16,0,12,4" ColumnSpacing="8">
            <Label Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Show archived" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Switch Grid.Column="2" IsToggled="{Binding ShowArchived}" VerticalOptions="Center"
                    SemanticProperties.Description="Show archived players" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None" Margin="12,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48" Spacing="12" HorizontalOptions="Center">
                    <Label Text="{Binding EmptyText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" FontSize="16" />
                    <Button Text="Add your first player" Command="{Binding AddPlayerCommand}"
                            IsVisible="{Binding HasNoPlayersAtAll}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="4,10"
                          MinimumHeightRequest="56"
                          SemanticProperties.Description="{Binding Name}"
                          SemanticProperties.Hint="{Binding Subtitle}">
                        <controls:AvatarView Grid.RowSpan="2" Initials="{Binding Initials}" ColorHex="{Binding Color}" Size="44" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                        <Label Grid.Column="2" Grid.RowSpan="2" Text="{Binding Nickname}" IsVisible="{Binding HasNickname}"
                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Button Grid.ColumnSpan="3" Grid.RowSpan="2" Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" Style="{StaticResource BottomBar}">
            <Button Text="Add player" Command="{Binding AddPlayerCommand}" Style="{StaticResource BigButton}"
                    MaximumWidthRequest="480" />
        </Border>
    </Grid>
</pages:BasePage>
