<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:PokerSettle.App.Pages"
                xmlns:controls="clr-namespace:PokerSettle.App.Controls"
                xmlns:vm="clr-namespace:PokerSettle.Core.ViewModels.Board;assembly=PokerSettle.Core"
                x:Class="PokerSettle.App.Pages.BoardPage"
                x:DataType="vm:BoardViewModel"
                Title="Board">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New game" Command="{Binding NewGameCommand}" Order="Primary" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- Wide windows: one table row per player. Columns match the header grid below. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:BoardItem">
            <Grid ColumnDefinitions="44,2*,100,92,92,60,64,92,92,92,104" ColumnSpacing="8" Padding="8,10" MinimumHeightRequest="52">
                <Label Text="{Binding RankText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                    <controls:AvatarView Initials="{Binding Initials}" ColorHex="{Binding Color}" Size="32" VerticalOptions="Center" />
                    <Label Text="{Binding Name}" Style="{StaticResource Strong}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
                <controls:SignedLabel Grid.Column="2" Text="{Binding NetText}" Sign="{Binding NetSign}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="{Binding WonText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="4" Text="{Binding LostText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="5" Text="{Binding GamesText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="6" Text="{Binding WinRateText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <controls:SignedLabel Grid.Column="7" Text="{Binding AverageText}" Sign="{Binding AverageSign}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="8" Text="{Binding BestText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="9" Text="{Binding WorstText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="10" Text="{Binding LastPlayedText}" HorizontalTextAlignment="End" VerticalOptions="Center" FontSize="15" Style="{StaticResource Secondary}" />
                <Button Grid.ColumnSpan="11" Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" CommandParameter="{Binding .}"
                        SemanticProperties.Description="{Binding Description}" />
            </Grid>
        </DataTemplate>

        <!-- Phones and narrow windows: compact cards. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:BoardItem">
            <Grid ColumnDefinitions="40,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" Padding="4,10">
                <Label Grid.RowSpan="3" Text="{Binding RankText}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                <controls:AvatarView Grid.Column="1" Grid.RowSpan="2" Initials="{Binding Initials}" ColorHex="{Binding Color}" Size="40" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                <controls:SignedLabel Grid.Column="3" Text="{Binding NetText}" Sign="{Binding NetSign}" FontSize="18" HorizontalTextAlignment="End" />
                <Label Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding CardDetails}" Style="{StaticResource Caption}" />
                <Label Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2" Text="{Binding CardExtremes}" Style="{StaticResource Caption}" />
                <Button Grid.ColumnSpan="4" Grid.RowSpan="3" Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" CommandParameter="{Binding .}"
                        SemanticProperties.Description="{Binding Description}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,*" Padding="12,4,12,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="TableHeader" Property="Grid.IsVisible" Value="False" />
                        <Setter TargetName="NarrowSort" Property="HorizontalStackLayout.IsVisible" Value="True" />
                        <Setter TargetName="BoardList" Property="CollectionView.ItemTemplate" Value="{StaticResource CardTemplate}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1040" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="TableHeader" Property="Grid.IsVisible" Value="True" />
                        <Setter TargetName="NarrowSort" Property="HorizontalStackLayout.IsVisible" Value="False" />
                        <Setter TargetName="BoardList" Property="CollectionView.ItemTemplate" Value="{StaticResource RowTemplate}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Filters -->
        <FlexLayout Wrap="Wrap" AlignItems="Center">
            <Picker ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" MinimumWidthRequest="180" Margin="0,0,12,4"
                    SemanticProperties.Description="Time period" />
            <HorizontalStackLayout IsVisible="{Binding IsCustom}" Spacing="6" Margin="0,0,12,4">
                <DatePicker Date="{Binding CustomFrom}" Format="d MMM yyyy" SemanticProperties.Description="From date" />
                <Label Text="to" VerticalOptions="Center" Style="{StaticResource Caption}" />
                <DatePicker Date="{Binding CustomTo}" Format="d MMM yyyy" SemanticProperties.Description="To date" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" Margin="0,0,12,4">
                <Label Text="Include archived" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IncludeArchived}" SemanticProperties.Description="Include archived players" />
            </HorizontalStackLayout>
        </FlexLayout>

        <!-- Narrow: sort picker -->
        <HorizontalStackLayout x:Name="NarrowSort" Grid.Row="1" Spacing="8" Margin="0,0,0,4">
            <Label Text="Sort by" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Picker ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex}" MinimumWidthRequest="160"
                    SemanticProperties.Description="Sort by" />
            <Button Text="{Binding DirectionText}" Style="{StaticResource TextButton}" Command="{Binding ToggleDirectionCommand}"
                    SemanticProperties.Description="Change sort direction" />
        </HorizontalStackLayout>

        <!-- Wide: sortable column headers -->
        <Grid x:Name="TableHeader" Grid.Row="2" ColumnDefinitions="44,2*,100,92,92,60,64,92,92,92,104" ColumnSpacing="8" Padding="8,0">
            <Label Text="#" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{Binding NameHeader}" Command="{Binding SortByCommand}" CommandParameter="Name" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="Start" Padding="0" SemanticProperties.Description="Sort by name" />
            <Button Grid.Column="2" Text="{Binding NetHeader}" Command="{Binding SortByCommand}" CommandParameter="Net" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by net total" />
            <Button Grid.Column="3" Text="{Binding WonHeader}" Command="{Binding SortByCommand}" CommandParameter="Won" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by total won" />
            <Button Grid.Column="4" Text="{Binding LostHeader}" Command="{Binding SortByCommand}" CommandParameter="Lost" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by total lost" />
            <Button Grid.Column="5" Text="{Binding GamesHeader}" Command="{Binding SortByCommand}" CommandParameter="Games" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by games played" />
            <Button Grid.Column="6" Text="{Binding WinRateHeader}" Command="{Binding SortByCommand}" CommandParameter="WinRate" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by win rate" />
            <Button Grid.Column="7" Text="{Binding AverageHeader}" Command="{Binding SortByCommand}" CommandParameter="Average" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by average per game" />
            <Button Grid.Column="8" Text="{Binding BestHeader}" Command="{Binding SortByCommand}" CommandParameter="BiggestWin" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by biggest win" />
            <Button Grid.Column="9" Text="{Binding WorstHeader}" Command="{Binding SortByCommand}" CommandParameter="BiggestLoss" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by biggest loss" />
            <Button Grid.Column="10" Text="{Binding LastHeader}" Command="{Binding SortByCommand}" CommandParameter="LastPlayed" Style="{StaticResource TextButton}" FontSize="14" HorizontalOptions="End" Padding="0" SemanticProperties.Description="Sort by last played" />
        </Grid>

        <CollectionView x:Name="BoardList" Grid.Row="3" ItemsSource="{Binding Rows}" SelectionMode="None"
                        ItemTemplate="{StaticResource CardTemplate}">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" Style="{StaticResource Secondary}" FontSize="16" HorizontalTextAlignment="Center" Margin="24,48" />
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="8,12,8,24" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</pages:BasePage>
