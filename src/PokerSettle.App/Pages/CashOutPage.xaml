<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:pages="clr-namespace:PokerSettle.App.Pages"
                xmlns:controls="clr-namespace:PokerSettle.App.Controls"
                xmlns:vm="clr-namespace:PokerSettle.Core.ViewModels.Games;assembly=PokerSettle.Core"
                x:Class="PokerSettle.App.Pages.CashOutPage"
                SnackbarInset="150"
                x:DataType="vm:CashOutViewModel"
                Title="Cash out">
    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,24" Spacing="8" MaximumWidthRequest="760">
                <Label Text="Enter what each player finished with. 0 is fine." Style="{StaticResource Secondary}" />
                <Label Text="{Binding WarningText}" Style="{StaticResource WarningText}"
                       IsVisible="{Binding WarningText, Converter={StaticResource HasText}}" />

                <!-- A small fixed list (one row per player), so BindableLayout keeps every Entry realized for Next-key focus. -->
                <VerticalStackLayout x:Name="RowsHost" Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CashOutRow">
                            <Border Style="{StaticResource Card}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,150" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                                    <controls:AvatarView Grid.RowSpan="2" Initials="{Binding Initials}" ColorHex="{Binding Color}" Size="40" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding BuyInText}" Style="{StaticResource Caption}" />
                                    <Entry Grid.Column="2" Grid.RowSpan="2" Text="{Binding AmountText}" Keyboard="Numeric"
                                           ReturnType="Next" Completed="OnAmountCompleted" HorizontalTextAlignment="End"
                                           Placeholder="Amount" FontSize="18" VerticalOptions="Center"
                                           SemanticProperties.Description="{Binding AmountDescription}">
                                        <Entry.Behaviors>
                                            <toolkit:SelectAllTextBehavior />
                                        </Entry.Behaviors>
                                    </Entry>
                                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Error}" Style="{StaticResource ErrorText}"
                                               IsVisible="{Binding Error, Converter={StaticResource HasText}}" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="{Binding MoneyHint}" Style="{StaticResource Caption}" VerticalOptions="Center"
                                                   IsVisible="{Binding MoneyHint, Converter={StaticResource HasText}}" />
                                            <controls:SignedLabel Text="{Binding ResultText}" Sign="{Binding ResultSign}" FontSize="16" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Unbalanced: never finalize silently -->
                <Border Style="{StaticResource Notice}" IsVisible="{Binding ShowDiscrepancy}" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding DiscrepancyText}" Style="{StaticResource Strong}" TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}"
                               SemanticProperties.HeadingLevel="Level3" />
                        <RadioButton GroupName="Discrepancy" Content="Fix the amounts (recommended)" IsChecked="{Binding IsFixSelected}" />
                        <RadioButton GroupName="Discrepancy" Content="{Binding SplitText}" IsChecked="{Binding IsSplitSelected}" />
                        <RadioButton GroupName="Discrepancy" Content="{Binding AssignText}" IsChecked="{Binding IsAssignSelected}" />
                        <Picker ItemsSource="{Binding PlayerNames}" SelectedIndex="{Binding AssignIndex}" Title="Who takes the difference?"
                                IsVisible="{Binding IsAssignSelected}" SemanticProperties.Description="Who takes the difference" />
                        <Label Text="The adjustment is saved with the game, so history shows exactly what happened." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                       IsVisible="{Binding ErrorText, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky footer -->
        <Border Grid.Row="1" Style="{StaticResource BottomBar}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" MaximumWidthRequest="760">
                <Label Style="{StaticResource Caption}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Bought in " />
                            <Span Text="{Binding TotalBuyInText}" FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Grid.Row="1" Style="{StaticResource Caption}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Cashed out " />
                            <Span Text="{Binding TotalCashOutText}" FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <controls:SignedLabel Grid.Row="2" Text="{Binding LeftText}" Sign="{Binding LeftSign}" FontSize="18" />
                <VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="6" VerticalOptions="Center">
                    <Button Text="{Binding FillRemainingText}" Style="{StaticResource SecondaryButton}" Command="{Binding FillRemainingCommand}"
                            IsVisible="{Binding CanFillRemaining}" FontSize="14"
                            SemanticProperties.Description="{Binding FillRemainingDescription}" />
                    <Button Text="Review" Command="{Binding ContinueCommand}" Style="{StaticResource BigButton}" MinimumWidthRequest="140" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</pages:BasePage>
