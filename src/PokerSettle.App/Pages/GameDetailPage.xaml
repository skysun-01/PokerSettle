<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:pages="clr-namespace:PokerSettle.App.Pages"
                xmlns:controls="clr-namespace:PokerSettle.App.Controls"
                xmlns:vm="clr-namespace:PokerSettle.Core.ViewModels.Games;assembly=PokerSettle.Core"
                x:Class="PokerSettle.App.Pages.GameDetailPage"
                x:DataType="vm:GameDetailViewModel"
                Title="{Binding Title}">
    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="HasText" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="6" MaximumWidthRequest="760">
            <Label Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
            <Label Text="{Binding PotText}" Style="{StaticResource Secondary}" />
            <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" />

            <!-- In progress -->
            <Border Style="{StaticResource Notice}" IsVisible="{Binding IsInProgress}" Margin="0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="This game is still in progress." VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                    <Button Grid.Column="1" Text="Resume" Command="{Binding ResumeCommand}" />
                </Grid>
            </Border>

            <!-- Results -->
            <VerticalStackLayout IsVisible="{Binding IsFinalized}" Spacing="6">
                <Label Text="Results" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="0,8"
                                      SemanticProperties.Description="{Binding Description}">
                                    <controls:AvatarView Grid.RowSpan="2" Initials="{Binding Initials}" ColorHex="{Binding Color}" Size="40" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding Details}" Style="{StaticResource Caption}" />
                                    <controls:SignedLabel Grid.Column="2" Grid.RowSpan="2" Text="{Binding NetText}" Sign="{Binding NetSign}" FontSize="18" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding SettlementText}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Notice}" IsVisible="{Binding AdjustmentText, Converter={StaticResource HasText}}">
                    <Label Text="{Binding AdjustmentText}" TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
                </Border>

                <!-- Payments -->
                <Label Text="{Binding PaymentsTitle}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transfers}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransferItem">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Text}" FontSize="17" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Grid.RowSpan="2" Text="{Binding PaidButtonText}" Command="{Binding TogglePaidCommand}"
                                                CommandParameter="{Binding .}" Style="{StaticResource OutlineButton}" VerticalOptions="Center"
                                                SemanticProperties.Description="{Binding PaidDescription}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsPaid}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Label Grid.Row="1" Text="{Binding PaidText}" Style="{StaticResource Caption}"
                                               IsVisible="{Binding PaidText, Converter={StaticResource HasText}}" />
                                        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding HasUpi}" Spacing="4" Margin="-12,0,0,0">
                                            <Button Text="{Binding UpiId, StringFormat='Copy UPI ID ({0})'}" Style="{StaticResource TextButton}"
                                                    Command="{Binding CopyUpiCommand}" CommandParameter="{Binding .}" FontSize="14" />
                                            <Button Text="Pay via UPI" Style="{StaticResource TextButton}" IsVisible="{Binding CanPayViaUpi}"
                                                    Command="{Binding PayUpiCommand}" CommandParameter="{Binding .}" FontSize="14" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding NoPaymentsText}" Style="{StaticResource Secondary}"
                               IsVisible="{Binding NoPaymentsText, Converter={StaticResource HasText}}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                    <Button Text="Share" Command="{Binding ShareCommand}" SemanticProperties.Hint="Share results and payments, for example on WhatsApp" />
                    <Button Grid.Column="1" Text="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}"
                            SemanticProperties.Hint="Copy results and payments as text" />
                </Grid>
            </VerticalStackLayout>

            <!-- Buy-ins and cash-outs -->
            <Label Text="Buy-ins and cash-outs" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BuyInLines}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="14" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasNotes}">
                <Label Text="Notes" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding Notes}" />
            </VerticalStackLayout>

            <!-- More -->
            <Label Text="More" Style="{StaticResource SectionTitle}" />
            <FlexLayout Wrap="Wrap">
                <Button Text="New game with same players" Style="{StaticResource OutlineButton}" Command="{Binding NewGameSameSettingsCommand}" Margin="0,0,8,8" />
                <Button Text="Reopen to edit" Style="{StaticResource OutlineButton}" Command="{Binding ReopenCommand}" IsVisible="{Binding IsFinalized}" Margin="0,0,8,8" />
                <Button Text="Delete game" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                        SemanticProperties.Hint="Deletes the game. You can undo right after." />
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
