<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:PokerSettle.App.Pages"
                xmlns:vm="clr-namespace:PokerSettle.Core.ViewModels;assembly=PokerSettle.Core"
                x:Class="PokerSettle.App.Pages.GamesPage"
                x:DataType="vm:GamesViewModel"
                Title="{Binding Title}">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="{Binding Title}" Style="{StaticResource Heading}" />
        <Label Text="Games history arrives in phase 3." Style="{StaticResource Secondary}" />
    </VerticalStackLayout>
</pages:BasePage>
