<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PokerSettle.App.Controls"
             x:Class="PokerSettle.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Every page: DEMO banner on top, content, and the in-app snackbar floating at the bottom. -->
            <ControlTemplate x:Key="PageTemplate">
                <Grid RowDefinitions="Auto,*">
                    <controls:DemoBanner Grid.Row="0" />
                    <ContentPresenter Grid.Row="1" />
                    <controls:SnackbarView Grid.Row="1" />
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
